# syntax=docker/dockerfile:1

# 打包命令：在仓库根目录 /workspaces/kubesphere 执行，构建单个平台并加载到本地镜像。
# docker buildx build --platform linux/amd64 \
#   -f build/ks-controller-manager/Dockerfile.controller-fix \
#   -t mingys/ks-controller-manager:v4.1.3-fix --load .
# 如需发布多平台镜像，可将 --platform 改为 linux/amd64,linux/arm64，并使用 --push。

# 第一阶段：使用 BuildKit 的构建平台镜像编译目标平台的 controller-manager。
FROM --platform=$BUILDPLATFORM golang:1.23.7 AS builder

# TARGETOS/TARGETARCH 由 docker buildx 根据 --platform 注入，用于交叉编译。
ARG TARGETOS
ARG TARGETARCH

# 将构建上下文放到统一目录，后续 make 命令从这里读取源码和构建配置。
WORKDIR /workspace

# 复制源码、Makefile 以及构建所需文件到编译容器中。
COPY . .

# 关闭 CGO，生成不依赖系统 C 库的静态二进制；输出平台由 TARGETOS/TARGETARCH 决定。
RUN GOOS="${TARGETOS}" \
    GOARCH="${TARGETARCH}" \
    CGO_ENABLED=0 \
    make ks-controller-manager

# 将编译产物整理到独立目录，便于下一阶段只复制需要替换的文件。
RUN mkdir -p /out/usr/local/bin && \
    cp /workspace/bin/cmd/controller-manager \
       /out/usr/local/bin/controller-manager && \
    chmod +x /out/usr/local/bin/controller-manager


# 第二阶段：继承 v4.1.3 镜像，保留其中已有的 telemetry、证书、Helm Chart 等运行时文件。
FROM docker.io/mingys/ks-controller-manager:v4.1.3

# 只覆盖基础镜像中的 controller-manager，完成修复版本镜像的组装。
# 到这里即完成最终镜像打包，镜像标签由上面的 buildx 命令通过 -t 指定。
COPY --from=builder \
    /out/usr/local/bin/controller-manager \
    /usr/local/bin/controller-manager
